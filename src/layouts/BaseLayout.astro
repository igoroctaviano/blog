---
import "../styles/reset.css";
import "../styles/blog.css";

interface Props {
  title: string;
  description?: string;
  isHome?: boolean;
}

const { title, description, isHome = false } = Astro.props;
const siteUrl = "https://igoroctaviano.com";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = isHome ? "Blog — Igor Octaviano" : `${title} — Igor Octaviano`;
const metaDescription =
  description ??
  "Artigos sobre desenvolvimento de software, Java, C# e conceitos de programação.";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content="#292040" />
    <meta name="color-scheme" content="dark" />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Julius+Sans+One&family=Raleway:wght@400;600&display=swap"
      rel="stylesheet"
    />

    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={`${import.meta.env.BASE_URL}favicon-32x32.png`}
    />
    <link rel="alternate" type="application/rss+xml" title="RSS" href={`${import.meta.env.BASE_URL}rss.xml`} />
  </head>
  <body>
    <header class="site-header">
      <h1>
        <a href={import.meta.env.BASE_URL}>Blog</a>
      </h1>
      <p class="site-tagline">Igor Octaviano</p>
      <nav class="site-nav" aria-label="Principal">
        <a href={siteUrl}>← Voltar ao site</a>
        <a href={`${import.meta.env.BASE_URL}rss.xml`}>RSS</a>
      </nav>
      <div class="divider" aria-hidden="true"></div>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      © {new Date().getFullYear()} Igor Octaviano
    </footer>
  </body>
</html>
